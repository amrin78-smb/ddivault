DB_HOST=localhost
DB_PORT=5432
DDI_DB_NAME=ddivault
DDI_DB_USER=ddivault_user
DDI_DB_PASS=your_db_password
DDI_API_PORT=3007
DDI_APP_PORT=3006
DDI_WS_PORT=3011
# Agent-WS ingest carries DECRYPTED WinRM creds; it refuses to start on a non-loopback
# bind without TLS unless this is set. =1 consciously accepts cleartext on a trusted LAN
# (the suite default). For an untrusted segment set DDI_WS_TLS_CERT/DDI_WS_TLS_KEY instead.
DDI_WS_ALLOW_PLAINTEXT=1
NEXTAUTH_SECRET=your_nextauth_secret
NOCVAULT_HUB_URL=http://your_server_ip:3000
NEXT_PUBLIC_NOCVAULT_HUB_URL=http://your_server_ip:3000
NETVAULT_DB_HOST=localhost
NETVAULT_DB_PORT=5432
NETVAULT_DB_NAME=netvault
NETVAULT_DB_USER=netvault
NETVAULT_DB_PASS=your_netvault_db_password
PS_AUTH_MODE=kerberos
PS_TIMEOUT_MS=30000
SCOPE_WARNING_PCT=80
SCOPE_CRITICAL_PCT=90
RETENTION_DAYS=90
SERVER_IP=your_server_ip

# ── Optional / advanced ───────────────────────────────────────────────────────
# All of the below are READ by the collector but were previously undocumented —
# a value could only be discovered by grepping the source. Every one is optional;
# the listed default is what the code falls back to when the var is absent.

# Encryption key for stored WinRM/SMTP credentials (collector/credStore.js).
# ONLY a fallback: the code uses NEXTAUTH_SECRET when set, and DDI_CRED_SECRET
# solely when it is not. The collector refuses to start if BOTH are missing —
# it will not silently encrypt real credentials under a hardcoded literal.
# FOOTGUN: the derived key is a SHA-256 of whichever one wins. If you run on
# DDI_CRED_SECRET and later ADD a different NEXTAUTH_SECRET, NEXTAUTH_SECRET
# takes over and every already-stored credential becomes undecryptable. Set one
# or the other and leave it alone; to migrate, re-enter the credentials.
# DDI_CRED_SECRET=

# Fleet-wide fallback WinRM credentials, used only for a ddi_servers row that has
# no per-server ps_username/ps_password of its own (collector/collector.js,
# collector/powershellRunner.js). Default: empty (per-server creds only).
# These sit in PLAINTEXT in this file, unlike per-server creds, which are
# encrypted at rest via credStore. Prefer per-server credentials in the UI;
# use these only where one service account genuinely covers the whole fleet.
# PS_USERNAME=
# PS_PASSWORD=

# One-time seed of the FIRST ddi_servers row on a fresh install, so a new box
# polls something before anyone opens the Known Servers tab. Ignored entirely
# once any server row exists, and ignored if the value is not a valid IP (the
# shipped SERVER_IP-style placeholder is skipped, not seeded).
# DNS_SERVER only picks the seeded row role: a valid IP that DIFFERS from
# DHCP_SERVER seeds role dhcp, otherwise role both. Default: no seed.
# DHCP_SERVER=
# DNS_SERVER=

# Read the DHCP audit log straight off a file path instead of over WinRM
# (collector/dhcpReader.js). Setting EITHER switches that transport for every
# server; unset (the default) uses the WinRM Get-DhcpServerAuditLog path.
# The literal token 192.168.x.x in DHCP_LOG_UNC is INTENTIONAL and is not a
# hardcoded IP: the collector substitutes each server ip_address into it per
# poll. DHCP_LOG_LOCAL takes no substitution and so suits a single server only.
# Note the suite ships with this feed deliberately OFF — see CLAUDE.md.
# DHCP_LOG_UNC=\\192.168.x.x\dhcp$
# DHCP_LOG_LOCAL=C:\Windows\System32\dhcp

# Hard ceiling for a single IPAM subnet sweep (collector/ipamScanner.js).
# Default: 300000 (5 minutes).
# SCAN_TIMEOUT_MS=300000
